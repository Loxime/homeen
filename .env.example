# HOMEEN - LOCAL DEVELOPMENT ONLY
COMPOSE_PROJECT_NAME=homeen
LOCAL_UID=1000
LOCAL_GID=1000
APP_ENV=dev
APP_SECRET=replace-with-a-long-random-local-secret
APP_TIMEZONE=Europe/Paris
ACCESS_KEY=replace-with-your-local-access-password

POSTGRES_DB=homeen
