# HOMEEN - LOCAL DEVELOPMENT ONLY
COMPOSE_PROJECT_NAME=homeen
LOCAL_UID=1000
LOCAL_GID=1000
APP_ENV=dev
APP_SECRET=replace-with-a-long-random-local-secret
APP_TIMEZONE=Europe/Paris
DEFAULT_URI=http://localhost:8080

POSTGRES_DB=homeen
POSTGRES_USER=homeen
POSTGRES_PASSWORD=replace-with-a-local-database-password

HOMEEN_HTTP_PORT=8080

# Mercure realtime hub
MERCURE_JWT_SECRET=replace-with-a-64-character-random-secret
MERCURE_PUBLIC_URL=http://localhost:8080/.well-known/mercure
